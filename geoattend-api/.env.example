# --- Database -------------------------------------------------------------
# Local:  postgresql://postgres:postgres@localhost:5432/geoattend
# Neon:   paste the NON-pooled connection string (turn "Pooled connection" OFF)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geoattend"

# --- Auth -----------------------------------------------------------------
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS=30
RESET_CODE_MINUTES=3

# --- App ------------------------------------------------------------------
PORT=3000
NODE_ENV=development
COMPANY_NAME="TTNet LTD"
TIMEZONE="Africa/Douala"      # used for "today" on the dashboards
OFFLINE_MAX_DAYS=7             # offline clock-ins older than this are rejected on sync
MAX_GPS_ACCURACY_METERS=150   # clock-in is refused if the GPS fix is less accurate than this
ABSENT_AFTER_HOUR=12          # dashboards count no-shows as absent after this local hour
CORS_ORIGIN="*"

# --- Email (optional in development: codes are printed to the console) ----
# Gmail: enable 2-step verification, create an "App password", use it below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GeoAttend <no-reply@geoattend.app>"

# --- First admin account (used by "npx prisma db seed" for a blank start) ---
# Password: at least 6 characters and a number. Change it inside the app afterwards.
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="ChangeMe123"
